# Copy to .env (never commit .env). Docker Compose reads this file automatically.

# --- SQL Server (development container) -------------------------------------
# Must satisfy SQL Server complexity rules (8+ chars, upper, lower, digit, symbol).
MSSQL_SA_PASSWORD=Change_Me_Dev#2026

# --- JWT (REQUIRED: min 32 characters; generate your own random value) ------
# e.g.  openssl rand -base64 48
JWT_SIGNING_KEY=

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=nexus
RABBITMQ_PASSWORD=nexus_dev_password

# --- Development administrator (created on first start, Development only) ---
# Leave both empty to create no admin. Use your own values; do not reuse real passwords.
ADMIN_EMAIL=admin@nexus.local
ADMIN_PASSWORD=mysecretpassword
ADMIN_RESET_PASSWORD=true
ASPNETCORE_ENVIRONMENT=Development

# --- AI assistant -----------------------------------------------------------
# Leave AI_API_KEY empty to run the rule-based fallback assistant (works out of the box).
# AI_PROVIDER: none | openai (OpenAI-compatible Chat Completions API) | anthropic (Messages API)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# Optional override (e.g. a compatible gateway). Defaults: https://api.openai.com/v1 | https://api.anthropic.com
AI_BASE_URL=

# --- Email (notifications) --------------------------------------------------
# log = write emails to the notification service log (default). smtp = send for real.
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- CORS (only needed if the browser calls the gateway on another origin) --
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
