{
  "Urls": "http://localhost:5100",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "nexus-identity",
    "Audience": "nexus-clients",
    "Key": ""
  },
  "Cors": {
    "Origins": "http://localhost:3000,http://localhost:5173"
  },
  "RateLimit": {
    "GlobalPerMinute": 600,
    "AuthPerMinute": 15
  },
  "Monitoring": {
    "Services": {
      "identity": "http://localhost:5101",
      "catalog": "http://localhost:5102",
      "inventory": "http://localhost:5103",
      "cart": "http://localhost:5104",
      "orders": "http://localhost:5105",
      "payments": "http://localhost:5106",
      "notifications": "http://localhost:5107",
      "reviews": "http://localhost:5108",
      "assistant": "http://localhost:5109"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "RateLimiterPolicy": "auth"
      },
      "identity-profile": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/profile/{**catch-all}"
        }
      },
      "identity-admin": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/admin/users/{**catch-all}"
        }
      },
      "catalog-products-read": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/products/{**catch-all}",
          "Methods": [
            "GET"
          ]
        }
      },
      "catalog-products-write": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/products/{**catch-all}",
          "Methods": [
            "POST",
            "PUT",
            "DELETE"
          ]
        }
      },
      "catalog-categories-read": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/categories/{**catch-all}",
          "Methods": [
            "GET"
          ]
        }
      },
      "catalog-categories-write": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/categories/{**catch-all}",
          "Methods": [
            "POST",
            "PUT",
            "DELETE"
          ]
        }
      },
      "inventory-public": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/inventory/{**catch-all}",
          "Methods": [
            "GET"
          ]
        }
      },
      "inventory-admin": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/admin/inventory/{**catch-all}"
        }
      },
      "cart": {
        "ClusterId": "cart",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        }
      },
      "orders": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "orders-admin": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/admin/orders/{**catch-all}"
        }
      },
      "payments": {
        "ClusterId": "payments",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "payments-admin": {
        "ClusterId": "payments",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/admin/payments/{**catch-all}"
        }
      },
      "notifications": {
        "ClusterId": "notifications",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "notifications-admin": {
        "ClusterId": "notifications",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/admin/notifications/{**catch-all}"
        }
      },
      "reviews-read": {
        "ClusterId": "reviews",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/reviews/{**catch-all}",
          "Methods": [
            "GET"
          ]
        }
      },
      "reviews-write": {
        "ClusterId": "reviews",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/reviews/{**catch-all}",
          "Methods": [
            "POST",
            "DELETE"
          ]
        }
      },
      "reviews-admin": {
        "ClusterId": "reviews",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/admin/reviews/{**catch-all}"
        }
      },
      "assistant": {
        "ClusterId": "assistant",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/assistant/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "inventory": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5103/"
          }
        }
      },
      "cart": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5104/"
          }
        }
      },
      "orders": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5105/"
          }
        }
      },
      "payments": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5106/"
          }
        }
      },
      "notifications": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5107/"
          }
        }
      },
      "reviews": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5108/"
          }
        }
      },
      "assistant": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5109/"
          }
        }
      }
    }
  }
}